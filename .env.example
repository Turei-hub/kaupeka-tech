# Copy to .env for local `vercel dev`. Set the real values in Vercel:
# Project Settings -> Environment Variables (Production, Preview and Development).

# Brevo -> SMTP & API -> API keys -> Generate a new API key.
# This is NOT the SMTP password used for Gmail "Send mail as".
BREVO_API_KEY=

# Sender must be a verified sender (or verified domain) in Brevo.
CONTACT_FROM=hello@kaupekadigital.com

# Where enquiries land. Routes to milner.turei@gmail.com via Cloudflare Email Routing.
CONTACT_TO=contact@kaupekadigital.com
